{
  "manifest_version": 3,
  "name": "Prompt Polish — Clearer prompts",
  "version": "0.2.0",
  "description": "Rewrite rough prompts with clearer English and relevant detail using Chrome AI where supported, or your Claude API key.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"],
  "optional_host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Prompt Polish",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://api.anthropic.com"
  }
}